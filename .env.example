# Copy this file to .env and fill in your API keys

# NVIDIA NIM API — https://integrate.api.nvidia.com
# Free tier: 1000 credits, register at build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API — https://console.groq.com
# Free tier available, very fast inference
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bybit API Credentials (optional for real trading mode)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
# Set to 'true' to use Bybit Testnet (recommended for safety), or 'false' for Mainnet (real funds)
BYBIT_USE_TESTNET=true

# Optional override:
# Use https://api-demo.bybit.com for Bybit Demo Trading accounts
# BYBIT_BASE_URL=https://api-demo.bybit.com

